// Local-Keys.xcconfig.template
// ローカル開発用APIキー設定テンプレート
//
// セットアップ手順:
// 1. このファイルを "Local-Keys.xcconfig" にコピー
// 2. YOUR_DEV_API_KEY_HERE を実際のGoogle Safe Browsing APIキーに置き換え
// 3. Xcodeプロジェクトに Local-Keys.xcconfig を追加
// 4. プロジェクト設定のDebugビルド設定でこのファイルを選択
//
// 注意: Local-Keys.xcconfig は .gitignore に含まれているため、Gitにコミットされません

// Google Safe Browsing API Key (開発用)
SAFE_BROWSING_API_KEY = YOUR_DEV_API_KEY_HERE

// アプリケーション設定
PRODUCT_BUNDLE_IDENTIFIER = jp.techguide.SafeQR.dev
PRODUCT_NAME = SafeQR (Dev)

// デバッグ用フラグ
DEBUG_MODE = YES
ENABLE_LOGGING = YES

// 開発環境用のカスタム設定
APP_ENVIRONMENT = development